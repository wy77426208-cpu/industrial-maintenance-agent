# =========================
# MySQL
# =========================
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=maintai

# =========================
# 模型提供方
# 可选：ALIYUN、OPENAI、OLLAMA
# =========================
LLM_TYPE=ALIYUN
EMBED_MODEL_TYPE=ALIYUN
VISION_MODEL_TYPE=ALIYUN

# =========================
# 阿里云 DashScope
# =========================
ALIYUN_ACCESS_KEY_SECRET=your_dashscope_api_key
CHAT_MODEL_NAME=qwen3-max
ALIYUN_EMBED_MODEL_NAME=text-embedding-v4
ALIYUN_VISION_MODEL_NAME=qwen-vl-max

# =========================
# OpenAI-compatible
# 仅在模型类型选择 OPENAI 时填写
# =========================
OPENAI_API_KEY=your_openai_compatible_api_key
OPENAI_BASE_URL=https://your-api-base-url/v1
OPENAI_MODEL_NAME=your_chat_model
OPENAI_EMBED_MODEL_NAME=your_embedding_model
OPENAI_VISION_MODEL_NAME=your_vision_model

# =========================
# Ollama
# 仅在模型类型选择 OLLAMA 时使用
# =========================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen3:7b
OLLAMA_EMBED_MODEL_NAME=qwen3-embedding:0.6b
OLLAMA_VISION_MODEL_NAME=qwen2.5vl:7b

# =========================
# 本地 Embedding
# =========================
LOCAL_EMBED_MODEL_NAME=BAAI/bge-small-zh-v1.5
LOCAL_EMBED_DEVICE=cpu